{
  "module": {
    "name": "callsdk",
    "type": "har",
    "description": "Useasy Call SDK",
    "deviceTypes": ["phone", "tablet"],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      {
        "name": "ohos.permission.MICROPHONE",
        "reason": "$string:mic_reason",
        "usedScene": {
          "abilities": [],
          "when": "inuse"
        }
      },
      { "name": "ohos.permission.GET_NETWORK_INFO" }
    ]
  }
}
